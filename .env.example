PORT=3000
DB_URI=mongodb://127.0.0.1:27017/social_app
REDIS_URL=redis://127.0.0.1:6379

# Email (Gmail app password)
EMAIL=your_email@gmail.com
PASSWORD=your_gmail_app_password

# 32 characters (used by AES-256)
ENCRYPTION_KEY=12345678901234567890123456789012

# JWT - use two different long random strings
ACCESS_TOKEN_SIGNATURE=change_me_access_secret
REFRESH_TOKEN_SIGNATURE=change_me_refresh_secret
ACCESS_TOKEN_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_IN=604800

# Google OAuth 2.0 Web client ID
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com